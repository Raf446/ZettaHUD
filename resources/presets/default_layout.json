      "colorHex": "0xFFF472B6",
      "isVisible": true
    },
    {
      "id": "proc_ram",
      "label": "PROC_MEM",
      "colorHex": "0xFFE879F9",
      "isVisible": false
    },
    {
      "id": "disk_io",
      "label": "NVME_IO",
      "colorHex": "0xFFFB923C",
      "isVisible": false
    },
    {
      "id": "net_rate",
      "label": "NET_IO",
      "colorHex": "0xFF2DD4BF",
      "isVisible": false
